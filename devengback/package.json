    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "eventsource-parser": "^3.0.2",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.3",
    "multer": "^2.0.2",
